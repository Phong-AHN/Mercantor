# The worker is a long-lived process: it holds a blocking Redis connection and
# cannot run on a request-scoped runtime. Deploy it as its own container.
FROM node:22-alpine AS base
RUN corepack enable
WORKDIR /app

FROM base AS deps
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY apps/worker/package.json apps/worker/
# `packages/db` and `packages/config` copy in full, not just their
# package.json, because `pnpm install` runs `packages/db`'s own
# `postinstall` (`prisma generate`) as part of installing this stage's
# dependencies - it needs `prisma.config.ts` and `prisma/schema.prisma` to
# find, and `prisma.config.ts` itself imports `@relay/config`'s real source
# (`loadRootEnv`), not just its package.json. Every other package here has
# no postinstall of its own, so a manifest-only copy is enough for them and
# keeps this layer's cache narrow to what can actually invalidate it.
COPY packages/config packages/config/
COPY packages/core/package.json packages/core/
COPY packages/db packages/db/
COPY packages/integrations/package.json packages/integrations/
COPY packages/observability/package.json packages/observability/
COPY packages/queue/package.json packages/queue/
COPY packages/rbac/package.json packages/rbac/
RUN pnpm install --frozen-lockfile --filter @relay/worker...

FROM base AS runner
ENV NODE_ENV=production
ENV RELAY_ROLE=worker
# The whole `deps` stage output, not just its top-level `node_modules` - pnpm's
# default isolated linker also creates a `node_modules/.bin` (with the
# `prisma` binary symlink) inside *each* workspace package, e.g.
# `packages/db/node_modules/.bin/prisma`. Copying only `/app/node_modules`
# leaves those nested ones behind, and `pnpm --filter @relay/db generate`
# below fails with `prisma: not found` even though the root `node_modules`
# looks complete.
COPY --from=deps /app /app
COPY . .
RUN pnpm --filter @relay/db generate

EXPOSE 3100
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -qO- http://localhost:3100/health || exit 1

CMD ["pnpm", "--filter", "@relay/worker", "start"]
