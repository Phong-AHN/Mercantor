# ---------------------------------------------------------------------------
# Mercantor - AHN x SHOPLINE Migration Portal
# Copy to .env and fill in. Never commit real values.
# ---------------------------------------------------------------------------

NODE_ENV=development
APP_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=debug

# Postgres (docker-compose maps 5433 to avoid clashing with a local install)
DATABASE_URL=postgresql://relay:relay@localhost:5433/relay?schema=public
DIRECT_URL=postgresql://relay:relay@localhost:5433/relay?schema=public

# Redis (BullMQ)
REDIS_URL=redis://localhost:6380

# 32 random bytes, base64. Generate: openssl rand -base64 32
SESSION_SIGNING_SECRET=ZGV2LW9ubHktc2Vzc2lvbi1zaWduaW5nLXNlY3JldC0zMmJ5dGUh
CREDENTIAL_ENCRYPTION_KEY=ZGV2LW9ubHktY3JlZGVudGlhbC1lbmNyeXB0aW9uLWtleTMy

# Object storage (MinIO locally, S3 in production)
S3_BUCKET=relay-media-dev
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9010
S3_ACCESS_KEY_ID=relayminio
S3_SECRET_ACCESS_KEY=relayminio
S3_FORCE_PATH_STYLE=true

# Legacy/unused since D-052 - every organization now self-configures its own
# Slack/ClickUp/Resend credentials at /integrations (encrypted per-org in the
# database). These do nothing any more; safe to leave blank. See TODO.md §3.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
CLICKUP_API_TOKEN=
CLICKUP_TEAM_ID=
RESEND_API_KEY=
EMAIL_FROM="AHN Migration Portal <portal@ahnmedia.example>"

# Platform-level OAuth apps (D-053) - optional, one-time registration for the
# whole deployment (not per organization). Powers the "Connect via Slack" /
# "Connect via ClickUp" button at /integrations; absent => that button stays
# hidden and organizations fall back to pasting a token manually. See
# TODO.md §3 for how to register each app.
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
CLICKUP_OAUTH_CLIENT_ID=
CLICKUP_OAUTH_CLIENT_SECRET=

# Worker
WORKER_HEALTH_PORT=3100
