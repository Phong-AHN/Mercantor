# ---------------------------------------------------------------------------
# Relay - AHN x SHOPLINE Migration Portal
# Copy to .env and fill in. Never commit real values.
# ---------------------------------------------------------------------------

NODE_ENV=development
APP_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=debug

# Postgres (docker-compose maps 5433 to avoid clashing with a local install)
DATABASE_URL=postgresql://relay:relay@localhost:5433/relay?schema=public
DIRECT_URL=postgresql://relay:relay@localhost:5433/relay?schema=public

# Redis (BullMQ)
REDIS_URL=redis://localhost:6380

# 32 random bytes, base64. Generate: openssl rand -base64 32
SESSION_SIGNING_SECRET=ZGV2LW9ubHktc2Vzc2lvbi1zaWduaW5nLXNlY3JldC0zMmJ5dGUh
CREDENTIAL_ENCRYPTION_KEY=ZGV2LW9ubHktY3JlZGVudGlhbC1lbmNyeXB0aW9uLWtleTMy

# Object storage (MinIO locally, S3 in production)
S3_BUCKET=relay-media-dev
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9010
S3_ACCESS_KEY_ID=relayminio
S3_SECRET_ACCESS_KEY=relayminio
S3_FORCE_PATH_STYLE=true

# Integrations - all optional. Absent => the mock adapter answers locally.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
CLICKUP_API_TOKEN=
CLICKUP_TEAM_ID=
RESEND_API_KEY=
EMAIL_FROM="AHN Migration Portal <portal@ahnmedia.example>"

# Worker
WORKER_HEALTH_PORT=3100
