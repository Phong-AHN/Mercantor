// Mercantor - AHN x SHOPLINE Migration Portal
//
// One merchant = one Project = one source of truth. Slack, ClickUp and email
// hang off that record as integrations; none of them owns status.
//
// Conventions carried over from AHN Orbit:
//   - UUIDv7 primary keys, so ids sort by creation time
//   - Timestamptz(3) everywhere, all values stored in UTC
//   - soft delete via deletedAt where a record must survive being removed
//   - money as integer minor units, never a float
//   - check constraints live in the migration and are load-bearing

// No custom `output`: the client is generated into `node_modules/.prisma`.
// A generated client outside node_modules makes Next's file tracer walk up
// looking for `schema.prisma` and glob the user's home directory.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

